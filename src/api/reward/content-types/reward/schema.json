{
	"kind": "collectionType",
	"collectionName": "rewards",
	"info": {
		"singularName": "reward",
		"pluralName": "rewards",
		"displayName": "Reward",
		"description": "Rewards that users can redeem with points"
	},
	"options": {
		"draftAndPublish": true
	},
	"attributes": {
		"owner": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user"
		},
		"title": {
			"type": "string",
			"required": true,
			"description": "Shown on Wallet Pass"
		},
		"subtitle": {
			"type": "string",
			"required": true,
			"maxLength": 44,
			"description": "Shown on Wallet Pass"
		},
		"description": {
			"type": "text",
			"required": true,
			"description": "Not shown on Wallet Pass"
		},
		"pointsCost": {
			"type": "integer",
			"required": true,
			"min": 0
		},
		"category": {
			"type": "string",
			"required": true
		},
		"isActive": {
			"type": "boolean",
			"default": true
		},
		"sortOrder": {
			"type": "integer",
			"default": 0,
			"required": false
		},
		"image": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": ["images"],
			"description": "Displayed at 4:3 (landscape) in the app. Images will fill the area and be center-cropped — keep important content away from the edges. Use imagePosition/imageScale/imageFocus to fine-tune. Recommended size: 1200x900px or similar 4:3 ratio."
		},
		"imagePosition": {
			"type": "enumeration",
			"enum": ["top", "center", "bottom", "left", "right"],
			"default": "center"
		},
		"imageScale": {
			"type": "decimal",
			"min": 0.1,
			"max": 3.0,
			"default": 1.0
		},
		"imageFocus": {
			"type": "json",
			"default": { "x": 0.5, "y": 0.5 }
		},
		"pointTransactions": {
			"type": "relation",
			"relation": "oneToMany",
			"target": "api::point-transaction.point-transaction",
			"mappedBy": "relatedReward"
		},
		"business": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "api::business.business",
			"inversedBy": "rewards"
		},
		"expirationDays": {
			"type": "integer",
			"default": 30
		},
		"termsConditions": {
			"type": "richtext"
		},
		"redemptionInstructions": {
			"type": "text"
		}
	}
}
